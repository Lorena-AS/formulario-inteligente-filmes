function criarFormulario() {
  var PERGUNTAS = [{"n": 1, "pergunta": "Você gostaria de assistir a um filme que te deixe triste ou feliz?", "opcoes": [["Triste", 2], ["Feliz", 3]]}, {"n": 2, "pergunta": "Você prefere uma história fantasiosa ou baseada na realidade?", "opcoes": [["Fantasia", 4], ["Realidade", 5]]}, {"n": 3, "pergunta": "Você prefere uma história fantasiosa ou baseada na realidade?", "opcoes": [["Fantasia", 6], ["Realidade", 7]]}, {"n": 4, "pergunta": "Você gosta daquele frio na barriga ao sentir medo?", "opcoes": [["Sim", 12], ["Não", 8]]}, {"n": 5, "pergunta": "Você gosta de ficar tentando adivinhar qual será o final do filme?", "opcoes": [["Sim", 15], ["Não", 9]]}, {"n": 6, "pergunta": "Você gosta de obras animadas e que remetem à infância?", "opcoes": [["Sim", 18], ["Não", 10]]}, {"n": 7, "pergunta": "Você gosta de bancar o(a) detetive e juntar pistas?", "opcoes": [["Sim", 21], ["Não", 11]]}, {"n": 8, "pergunta": "Se você pudesse ter um poder, qual seria?", "opcoes": [["Fazer feitiços e conviver com criaturas mágicas", 13], ["Viajar pelo espaço-tempo / descobrir o universo", 14]]}, {"n": 9, "pergunta": "O que mais te faz chorar em um filme?", "opcoes": [["Um amor que não deu certo", 16], ["Alguém enfrentando as dificuldades da vida", 17]]}, {"n": 10, "pergunta": "Se você pudesse ter um poder, qual seria?", "opcoes": [["Fazer feitiços e conviver com criaturas mágicas", 19], ["Viajar pelo espaço-tempo / descobrir o universo", 20]]}, {"n": 11, "pergunta": "O que mais te deixa com um sorriso no rosto?", "opcoes": [["Ver um casal ficando junto no final, apesar de tudo", 22], ["Ver alguém superando um desafio", 23]]}];
  var RESULTADOS = [{"n": 12, "genero": "Terror", "filme": "Faça ela Voltar (2025)", "texto": "Você quer um filme que mexa com suas emoções, gosta de histórias fora da realidade e não tem medo de levar sustos. Seu gênero é TERROR!", "sobre": "Após a morte trágica do pai, os meio-irmãos Andy e Piper vão parar no sistema de assistência social. Como Andy ainda não tem a maioridade legal para assumir a guarda da irmã, ambos são encaminhados temporariamente para um lar adotivo isolado. Lá, a nova responsável pela casa, Laura, guarda um segredo sombrio: um ritual macabro para trazer de volta a filha que perdeu.", "titulo": "Seu resultado: Terror"}, {"n": 13, "genero": "Fantasia (triste)", "filme": "Ponte para Terabítia (2007)", "texto": "Você quer se emocionar, prefere fugir da realidade e sonha com magia e criaturas encantadas. Seu gênero é FANTASIA, com uma história que vai apertar seu coração!", "sobre": "Dois amigos solitários criam um reino mágico na floresta chamado Terabítia para fugir dos problemas da escola e da realidade. O que parece ser uma aventura inocente toma um rumo profundamente devastador e comovente sobre luto e amadurecimento.", "titulo": "Seu resultado: Fantasia"}, {"n": 14, "genero": "Sci-fi (triste)", "filme": "Interestelar (2014)", "texto": "Você quer se emocionar e se interessa pelo futuro, pela tecnologia e pelo universo. Seu gênero é FICÇÃO CIENTÍFICA, com uma história que vai te fazer pensar (e talvez chorar)!", "sobre": "Em um futuro próximo em que a Terra está à beira do colapso devido à escassez de recursos e tempestades de poeira, um grupo de astronautas liderado pelo ex-piloto Cooper viaja através de um buraco de minhoca próximo a Saturno. A missão tem como objetivo encontrar um novo planeta habitável e garantir a sobrevivência da raça humana, forçando Cooper a deixar seus filhos para trás e enfrentar os desafios da relatividade do tempo no espaço.", "titulo": "Seu resultado: Sci-fi"}, {"n": 15, "genero": "Mistério com plot twist", "filme": "Ilha do Medo (2010)", "texto": "Você quer uma história intensa, baseada na realidade, e adora tentar descobrir o que vai acontecer. Seu gênero é MISTÉRIO COM PLOT TWIST: prepare-se para um final que vai virar tudo de cabeça para baixo!", "sobre": "Nos anos 1950, a fuga de uma assassina leva o detetive Teddy Daniels e seu parceiro a investigarem o seu desaparecimento de um quarto trancado em um hospital psiquiátrico. Lá, uma rebelião se inicia e o agente terá que enfrentar seus próprios medos.", "titulo": "Seu resultado: Mistério com plot twist"}, {"n": 16, "genero": "Romance (triste)", "filme": "Titanic (1997)", "texto": "Você quer se emocionar com uma história real e o que mais te toca são os amores que não deram certo. Seu gênero é ROMANCE. Separe os lencinhos!", "sobre": "A história narra o amor proibido entre Jack, um jovem artista pobre, e Rose, uma jovem aristocrata sufocada por sua classe social, a bordo do luxuoso transatlântico RMS Titanic. Juntos, eles desafiam as convenções sociais da época e vivem uma intensa paixão durante a viagem inaugural do navio em 1912. No entanto, o romance se transforma em uma luta desesperada pela sobrevivência quando o navio colide com um iceberg e começa a afundar nas águas congelantes do Atlântico Norte.", "titulo": "Seu resultado: Romance"}, {"n": 17, "genero": "Drama (triste)", "filme": "Réquiem para um Sonho (2000)", "texto": "Você quer se emocionar e se conecta com histórias de pessoas enfrentando as dificuldades da vida. Seu gênero é DRAMA!", "sobre": "As utopias causadas pelo uso de drogas em quatro pessoas de Coney Island se rompem quando seus vícios as dominam.", "titulo": "Seu resultado: Drama"}, {"n": 18, "genero": "Animação", "filme": "Zootopia: Essa Cidade é o Bicho (2016)", "texto": "Você quer um filme leve, cheio de imaginação, que agrada pessoas de todas as idades. Seu gênero é ANIMAÇÃO!", "sobre": "Judy Hopps é uma coelha otimista que realiza o sonho de se tornar a primeira policial coelha na grande metrópole de Zootopia. Subestimada pelo chefe e colocada apenas no posto de guarda de trânsito, ela se desafia a resolver o misterioso desaparecimento de vários moradores animais. Para isso, Judy é forçada a fazer uma aliança improvável com Nick Wilde, uma raposa malandra e trambiqueira. Juntos, eles descobrem uma grande conspiração que ameaça a harmonia da cidade.", "titulo": "Seu resultado: Animação"}, {"n": 19, "genero": "Fantasia (feliz)", "filme": "Piratas do Caribe: A Maldição do Pérola Negra (2003)", "texto": "Você quer se divertir, fugir da realidade e mergulhar em um mundo de magia e criaturas encantadas. Seu gênero é FANTASIA, com uma aventura que vai te deixar sorrindo!", "sobre": "O capitão Jack Sparrow se une ao jovem ferreiro Will Turner para resgatar Elizabeth Swann, a filha do governador sequestrada pelo capitão Barbossa.", "titulo": "Seu resultado: Fantasia"}, {"n": 20, "genero": "Sci-fi (feliz)", "filme": "De Volta para o Futuro (1985)", "texto": "Você quer uma história divertida e se empolga com tecnologia e viagens no tempo. Seu gênero é FICÇÃO CIENTÍFICA, com muita aventura e bom humor!", "sobre": "O adolescente Marty McFly é transportado para o ano de 1955 quando uma experiência do excêntrico cientista Doc Brown é malsucedida. Marty viaja pelo tempo em um carro modificado e acaba conhecendo seus pais ainda jovens. O problema é que ele pode deixar de existir porque interferiu na rotina dos pais, que correm o risco de não se apaixonarem mais. Para complicar ainda mais a situação, Marty precisa voltar para casa a tempo de salvar o cientista.", "titulo": "Seu resultado: Sci-fi"}, {"n": 21, "genero": "Mistério clássico", "filme": "Assassinato no Expresso do Oriente (2017)", "texto": "Você adora juntar pistas como um(a) detetive. Seu gênero é MISTÉRIO CLÁSSICO: uma investigação para acompanhar passo a passo!", "sobre": "Ocorre um assassinato em um luxuoso trem. O famoso detetive Hercule Poirot, que também estava a bordo, precisa correr contra o tempo para resolver o caso.", "titulo": "Seu resultado: Mistério clássico"}, {"n": 22, "genero": "Romance (feliz)", "filme": "Orgulho e Preconceito (2005)", "texto": "Você quer um filme leve e adora ver um casal ficando junto no final. Seu gênero é ROMANCE, daqueles que deixam o coração quentinho!", "sobre": "Elizabeth Bennet vive com sua mãe, pai e irmãs no campo, na Inglaterra. Por ser uma das filhas mais velhas, ela enfrenta uma crescente pressão de seus pais para se casar. Quando Elizabeth é apresentada ao belo e rico Darcy, faíscas voam. Embora haja uma química óbvia entre os dois, a natureza excessivamente reservada de Darcy ameaça a relação.", "titulo": "Seu resultado: Romance"}, {"n": 23, "genero": "Drama (feliz)", "filme": "À procura da Felicidade (2007)", "texto": "Você quer sair do filme inspirado(a) e adora histórias de pessoas superando desafios. Seu gênero é DRAMA DE SUPERAÇÃO!", "sobre": "Baseado em uma história real, acompanha Chris Gardner, um pai de família que enfrenta sérios problemas financeiros e a ausência de teto, mas luta com todas as forças para criar o pequeno filho e dar a volta por cima.", "titulo": "Seu resultado: Drama"}];
  var form = FormApp.create('Qual filme assistir hoje?');
  form.setDescription('Responda algumas perguntas rápidas e descubra o gênero e o filme ideal para o seu momento!');
  form.setConfirmationMessage('Obrigado por responder! Bom filme!');
  form.setProgressBar(false);
  try { form.setRequireLogin(false); } catch (e) {}
  var paginas = {}, itens = {};
  function titulo(n) { return n <= 1 ? '' : n <= 3 ? 'Pergunta 2' : n <= 7 ? 'Pergunta 3' : 'Pergunta 4'; }
  for (var n = 1; n <= 23; n++) {
    if (n > 1) { paginas[n] = form.addPageBreakItem(); }
    if (n <= 11) {
      var p = PERGUNTAS[n - 1];
      if (n > 1) paginas[n].setTitle(titulo(n));
      itens[n] = form.addMultipleChoiceItem().setTitle(p.pergunta).setRequired(true);
    } else {
      var r = RESULTADOS[n - 12];
      paginas[n].setTitle(r.titulo).setHelpText(r.texto + '\n\nFilme recomendado: ' + r.filme + '\n\nSobre: ' + r.sobre);
    }
  }
  for (var n = 1; n <= 11; n++) {
    var p = PERGUNTAS[n - 1], item = itens[n];
    item.setChoices(p.opcoes.map(function (o) { return item.createChoice(o[0], paginas[o[1]]); }));
  }
  for (var n = 13; n <= 23; n++) { paginas[n].setGoToPage(FormApp.PageNavigationType.SUBMIT); }
  Logger.log('EDITAR: ' + form.getEditUrl());
  Logger.log('RESPONDER: ' + form.getPublishedUrl());
}

function criarFormulario() {
  var PERGUNTAS = [{"n": 1, "pergunta": "Você gostaria de assistir a um filme que te deixe triste ou feliz?", "opcoes": [["Triste", 2], ["Feliz", 3]]}, {"n": 2, "pergunta": "Você prefere uma história fantasiosa ou baseada na realidade?", "opcoes": [["Fantasia", 4], ["Realidade", 5]]}, {"n": 3, "pergunta": "Você prefere uma história fantasiosa ou baseada na realidade?", "opcoes": [["Fantasia", 6], ["Realidade", 7]]}, {"n": 4, "pergunta": "Você gosta daquele frio na barriga ao sentir medo?", "opcoes": [["Sim", 12], ["Não", 8]]}, {"n": 5, "pergunta": "Você gosta de ficar tentando adivinhar qual será o final do filme?", "opcoes": [["Sim", 15], ["Não", 9]]}, {"n": 6, "pergunta": "Você gosta de obras animadas e que remetem à infância?", "opcoes": [["Sim", 18], ["Não", 10]]}, {"n": 7, "pergunta": "Você gosta de bancar o(a) detetive e juntar pistas?", "opcoes": [["Sim", 21], ["Não", 11]]}, {"n": 8, "pergunta": "Se você pudesse ter um poder, qual seria?", "opcoes": [["Fazer feitiços e conviver com criaturas mágicas", 13], ["Viajar pelo espaço-tempo / descobrir o universo", 14]]}, {"n": 9, "pergunta": "O que mais te faz chorar em um filme?", "opcoes": [["Um amor que não deu certo", 16], ["Alguém enfrentando as dificuldades da vida", 17]]}, {"n": 10, "pergunta": "Se você pudesse ter um poder, qual seria?", "opcoes": [["Fazer feitiços e conviver com criaturas mágicas", 19], ["Viajar pelo espaço-tempo / descobrir o universo", 20]]}, {"n": 11, "pergunta": "O que mais te deixa com um sorriso no rosto?", "opcoes": [["Ver um casal ficando junto no final, apesar de tudo", 22], ["Ver alguém superando um desafio", 23]]}];
  var RESULTADOS = [{"n": 12, "genero": "Terror", "filme": "Faça Ela Voltar (2025)", "texto": "Você quer um filme que mexa com suas emoções, gosta de histórias fora da realidade e não tem medo de levar sustos. Seu gênero é TERROR!", "sobre": "Após perderem o pai, os irmãos Andy e Piper vão morar com Laura, uma mãe adotiva que esconde um plano sombrio para trazer de volta a filha que perdeu.", "titulo": "Seu resultado: Terror"}, {"n": 13, "genero": "Fantasia (triste)", "filme": "Ponte para Terabítia (2007)", "texto": "Você quer se emocionar, prefere fugir da realidade e sonha com magia e criaturas encantadas. Seu gênero é FANTASIA, com uma história que vai apertar seu coração!", "sobre": "Jess e Leslie, dois colegas de escola, criam um reino imaginário na floresta, onde encontram refúgio e uma amizade que muda suas vidas.", "titulo": "Seu resultado: Fantasia"}, {"n": 14, "genero": "Sci-fi (triste)", "filme": "Interestelar (2014)", "texto": "Você quer se emocionar e se interessa pelo futuro, pela tecnologia e pelo universo. Seu gênero é FICÇÃO CIENTÍFICA, com uma história que vai te fazer pensar (e talvez chorar)!", "sobre": "Com a Terra à beira do colapso, o ex-piloto Cooper deixa os filhos, incluindo a pequena Murph, para atravessar o espaço em busca de um novo lar para a humanidade.", "titulo": "Seu resultado: Sci-fi"}, {"n": 15, "genero": "Mistério com plot twist", "filme": "Ilha do Medo (2010)", "texto": "Você quer uma história intensa, baseada na realidade, e adora tentar descobrir o que vai acontecer. Seu gênero é MISTÉRIO COM PLOT TWIST: prepare-se para um final que vai virar tudo de cabeça para baixo!", "sobre": "Os agentes federais Teddy Daniels e Chuck Aule investigam o sumiço de uma paciente em um hospital psiquiátrico isolado em uma ilha.", "titulo": "Seu resultado: Mistério com plot twist"}, {"n": 16, "genero": "Romance (triste)", "filme": "Titanic (1997)", "texto": "Você quer se emocionar com uma história real e o que mais te toca são os amores que não deram certo. Seu gênero é ROMANCE. Separe os lencinhos!", "sobre": "Rose, uma jovem da alta sociedade, e Jack, um artista sem dinheiro, se apaixonam durante a viagem inaugural do navio mais famoso da história.", "titulo": "Seu resultado: Romance"}, {"n": 17, "genero": "Drama (triste)", "filme": "Réquiem para um Sonho (2000)", "texto": "Você quer se emocionar e se conecta com histórias de pessoas enfrentando as dificuldades da vida. Seu gênero é DRAMA!", "sobre": "Harry, sua namorada Marion, seu amigo Tyrone e sua mãe, Sara, veem seus sonhos desmoronarem aos poucos por causa do vício.", "titulo": "Seu resultado: Drama"}, {"n": 18, "genero": "Animação", "filme": "Zootopia: Essa Cidade é o Bicho (2016)", "texto": "Você quer um filme leve, cheio de imaginação, que agrada pessoas de todas as idades. Seu gênero é ANIMAÇÃO!", "sobre": "A coelha Judy Hopps, uma policial novata, se une ao trapaceiro Nick Wilde, uma raposa, para resolver uma série de desaparecimentos na cidade dos animais.", "titulo": "Seu resultado: Animação"}, {"n": 19, "genero": "Fantasia (feliz)", "filme": "Piratas do Caribe: A Maldição do Pérola Negra (2003)", "texto": "Você quer se divertir, fugir da realidade e mergulhar em um mundo de magia e criaturas encantadas. Seu gênero é FANTASIA, com uma aventura que vai te deixar sorrindo!", "sobre": "O ferreiro Will Turner se alia ao excêntrico pirata Jack Sparrow para resgatar Elizabeth Swann das mãos do capitão Barbossa e sua tripulação amaldiçoada.", "titulo": "Seu resultado: Fantasia"}, {"n": 20, "genero": "Sci-fi (feliz)", "filme": "De Volta para o Futuro (1985)", "texto": "Você quer uma história divertida e se empolga com tecnologia e viagens no tempo. Seu gênero é FICÇÃO CIENTÍFICA, com muita aventura e bom humor!", "sobre": "Marty McFly viaja ao passado por acidente em uma invenção do cientista Doc Brown e precisa garantir que seus pais se apaixonem para conseguir voltar para casa.", "titulo": "Seu resultado: Sci-fi"}, {"n": 21, "genero": "Mistério clássico", "filme": "Assassinato no Expresso do Oriente (2017)", "texto": "Você adora juntar pistas como um(a) detetive. Seu gênero é MISTÉRIO CLÁSSICO: uma investigação para acompanhar passo a passo!", "sobre": "O famoso detetive Hercule Poirot precisa descobrir quem cometeu um assassinato a bordo de um trem de luxo preso na neve.", "titulo": "Seu resultado: Mistério clássico"}, {"n": 22, "genero": "Romance (feliz)", "filme": "Orgulho e Preconceito (2005)", "texto": "Você quer um filme leve e adora ver um casal ficando junto no final. Seu gênero é ROMANCE, daqueles que deixam o coração quentinho!", "sobre": "Elizabeth Bennet, uma jovem de opiniões fortes, e o rico e reservado Sr. Darcy precisam superar as primeiras impressões que tiveram um do outro.", "titulo": "Seu resultado: Romance"}, {"n": 23, "genero": "Drama (feliz)", "filme": "À procura da Felicidade (2007)", "texto": "Você quer sair do filme inspirado(a) e adora histórias de pessoas superando desafios. Seu gênero é DRAMA DE SUPERAÇÃO!", "sobre": "Baseado em uma história real, Chris Gardner, um pai sem dinheiro e sem casa, luta por uma vaga de emprego para dar uma vida melhor ao filho, Christopher.", "titulo": "Seu resultado: Drama"}];
  var form = FormApp.create('Qual filme assistir?');
  form.setDescription('Responda algumas perguntas rápidas e descubra o gênero e o filme ideal para o seu momento!');
  form.setConfirmationMessage('Obrigado por responder! Bom filme!');
  form.setProgressBar(false);
  try { form.setRequireLogin(false); } catch (e) {}
  var paginas = {}, itens = {};
  function titulo(n) { return n <= 1 ? '' : n <= 3 ? 'Pergunta 2' : n <= 7 ? 'Pergunta 3' : 'Pergunta 4'; }
  for (var n = 1; n <= 23; n++) {
    if (n > 1) { paginas[n] = form.addPageBreakItem(); }
    if (n <= 11) {
      var p = PERGUNTAS[n - 1];
      if (n > 1) paginas[n].setTitle(titulo(n));
      itens[n] = form.addMultipleChoiceItem().setTitle(p.pergunta).setRequired(true);
    } else {
      var r = RESULTADOS[n - 12];
      paginas[n].setTitle(r.titulo).setHelpText(r.texto + '\n\nFilme recomendado: ' + r.filme + '\n\nSobre: ' + r.sobre);
    }
  }
  for (var n = 1; n <= 11; n++) {
    var p = PERGUNTAS[n - 1], item = itens[n];
    item.setChoices(p.opcoes.map(function (o) { return item.createChoice(o[0], paginas[o[1]]); }));
  }
  for (var n = 13; n <= 23; n++) { paginas[n].setGoToPage(FormApp.PageNavigationType.SUBMIT); }
  Logger.log('EDITAR: ' + form.getEditUrl());
  Logger.log('RESPONDER: ' + form.getPublishedUrl());
}
